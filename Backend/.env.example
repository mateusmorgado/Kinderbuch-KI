# HTTP server
PORT=8082
NODE_ENV=development

# MongoDB Atlas connection string (include the database name before the "?")
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kinderbuch?retryWrites=true&w=majority

# JWT secret for login (use a long random string)
ACCESS_TOKEN_SECRET=

# Browser origins allowed to call the API, comma-separated.
# Default: https://kinderbuch-ki.vercel.app,http://localhost:3000
CORS_ORIGINS=

# Gemini API key for story and image generation
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_IMAGE_MODEL=

# Public URL of this backend, used in image URLs and as the OAuth issuer of
# the MCP server. Optional: by default it is derived from the incoming request.
PUBLIC_API_URL=

# Public URL of the website, used in story links the MCP tools return and on
# the MCP login page. Default: https://kinderbuch-ki.vercel.app
FRONTEND_URL=

# Generated story images are stored in MongoDB by default. Optionally set a
# Google Cloud Storage bucket to store them there instead.
GCS_BUCKET_NAME=
# Optional when the project cannot be derived from the credentials.
GCS_PROJECT_ID=
# Service account key: EITHER a path to the key file ...
GOOGLE_APPLICATION_CREDENTIALS=
# ... OR the whole key JSON on a single line (useful for hosted deployments).
GCS_CREDENTIALS_JSON=

# ElevenLabs text to speech, used to read stories aloud. Without a key the
# "Vorlesen" button answers that narration is not set up.
ELEVENLABS_API_KEY=
# Optional: model (default eleven_multilingual_v2, which speaks German and
# English) and the voice IDs for the female and male narrator.
ELEVENLABS_MODEL=
ELEVENLABS_VOICE_FEMALE=
ELEVENLABS_VOICE_MALE=
