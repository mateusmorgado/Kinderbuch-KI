# HTTP server
PORT=8082
NODE_ENV=development

# MongoDB Atlas connection string (include the database name before the "?")
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kinderbuch?retryWrites=true&w=majority

# JWT secrets for login (use long random strings)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Gemini API key for story and image generation
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_IMAGE_MODEL=

# Public URL of this backend, used in image URLs. Optional: by default it is
# derived from the incoming request.
PUBLIC_API_URL=

# Generated story images are stored in MongoDB by default. Optionally set a
# Google Cloud Storage bucket to store them there instead.
GCS_BUCKET_NAME=
# Optional when the project cannot be derived from the credentials.
GCS_PROJECT_ID=
# Service account key: EITHER a path to the key file ...
GOOGLE_APPLICATION_CREDENTIALS=
# ... OR the whole key JSON on a single line (useful for hosted deployments).
GCS_CREDENTIALS_JSON=
